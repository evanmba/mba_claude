# ─── Athlete Weekly Check-In → Google Sheet storage ─────────────────────────
# See ATHLETE_CHECKIN_SETUP.md for step-by-step setup.

# The spreadsheet ID from the Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
ATHLETE_SHEET_ID=

# Tab (worksheet) name to append rows to. Defaults to "CheckIns" if unset.
ATHLETE_SHEET_TAB=CheckIns

# Option A (recommended): paste the FULL service-account JSON key on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: the two discrete fields from the JSON key instead of the blob above.
# Keep the \n escape sequences in the private key — the app converts them.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
